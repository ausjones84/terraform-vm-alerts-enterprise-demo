# ---------------------------------------------------------------------------
# terraform-scripts/dmz/postgres-alerts/terraform.tfvars.example
# ---------------------------------------------------------------------------

resource_group_name = "rg-monitoring-dmz"

action_group_id = "/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/rg-monitoring-dmz/providers/microsoft.insights/actionGroups/ag-vm-alerts-dmz"

cpu_threshold = 70
storage_threshold = 70
connections_threshold = 70
severity = 1
connections_severity = 1
frequency = "PT1M"
window_size = "PT5M"

postgres_servers = [
{
name = "pg-dmz-proxy-01"
resource_id = "/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/rg-dmz/providers/Microsoft.DBforPostgreSQL/flexibleServers/pg-dmz-proxy-01"
}
]

tags = {
environment = "dmz"
managed_by = "terraform"
project = "vm-alerts"
team = "platform-engineering"
}
