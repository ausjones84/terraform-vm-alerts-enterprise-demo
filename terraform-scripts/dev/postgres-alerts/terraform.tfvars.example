# ---------------------------------------------------------------------------
# terraform-scripts/dev/postgres-alerts/terraform.tfvars.example
#
# Copy this file to terraform.tfvars and populate with real values.
# Do NOT commit terraform.tfvars to source control.
# ---------------------------------------------------------------------------

resource_group_name = "rg-monitoring-dev"

action_group_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-monitoring-dev/providers/microsoft.insights/actionGroups/ag-vm-alerts-dev"

# Azure Database for PostgreSQL Flexible Server inventory
postgres_servers = [
{
name = "pg-app-dev-01"
resource_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-db-dev/providers/Microsoft.DBforPostgreSQL/flexibleServers/pg-app-dev-01"
}
]

cpu_threshold = 80
storage_threshold = 80
connections_threshold = 80
severity = 2
connections_severity = 2
frequency = "PT5M"
window_size = "PT15M"

tags = {
environment = "dev"
managed_by = "terraform"
team = "platform-engineering"
}
